---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧑‍🚀 Hello, Astronaut!</h1>
			<h2>Mission</h2>
			<p>
				Our mission is to help you connect with other people.
			</p>
			<h2>Why</h2>
			<p>
			 Social connections impact mental and physical health.
			</p>
			<h2>Values</h2>
			<p>We value:</p>
			<ul>
				<li>Diversity</li>
				<li>Equity</code></li>
				<li>Inclusion</code></li>
				<li>Love</code></li>
				<li>Time</li>
				<li>Honesty</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
